# FlowCheck configuration. Copy to .env and adjust. Never commit .env.

# Master encryption key for secrets and auth profiles.
# Either "base64:<32 random bytes, base64>" or a passphrase (min 16 chars, derived with scrypt).
# If unset, a key file is generated at data/master.key on first start.
# If this key is lost, stored secrets and auth profiles cannot be recovered.
FLOWCHECK_MASTER_KEY=

# Directory for SQLite DB, artifacts and key files (default: ./data)
FLOWCHECK_DATA_DIR=./data

FLOWCHECK_SERVER_PORT=4310
DEMO_PORT=4320

# Demo bug mode: success | create-order-500 | ui-success-but-no-order | cart-not-cleared
DEMO_BUG_MODE=success
